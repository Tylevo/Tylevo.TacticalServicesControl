<Project>
  <!-- Machine-local inputs must be read before any dependent paths are evaluated. -->
  <Import Project="$(MSBuildThisFileDirectory)Shared.User.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Shared.User.props')" />
  <PropertyGroup>
    <Version>1.3.13</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <TargetSptVersion>4.1.5</TargetSptVersion>
    <Authors>Tylevo</Authors>
    <Copyright>Tylevo, SamSWAT, Arys</Copyright>
    <LangVersion>latest</LangVersion>
    <Configurations>Debug;SPT-3.10 Release;SPT-3.11 Release;SPT-4.0 Release;SPT-4.1 Release</Configurations>
    <Platforms>AnyCPU</Platforms>
    <SolutionName>Tylevo.TacticalServicesControl</SolutionName>
    <DistributionDir>$(MSBuildThisFileDirectory)dist\</DistributionDir>
    <ReleaseArchive>$(DistributionDir)$(SolutionName)-v$(Version)-SPT$(TargetSptVersion)-TESTER.zip</ReleaseArchive>
    <!-- Custom Build outputs must never become SDK CandidateAssemblyFiles;
         stale configurations can otherwise outrank explicit HintPaths. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Build\**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Ordinary builds never install files. Deployment is an explicit opt-in. -->
    <SkipTscDeploy Condition=" '$(SkipTscDeploy)' == '' ">true</SkipTscDeploy>
    <!-- Set both input roots in Shared.User.props or on the command line.
         No repository depth, sibling checkout, or live installation is assumed. -->
    <SptDir Condition=" '$(SptDir)' != '' ">$([MSBuild]::EnsureTrailingSlash('$(SptDir)'))</SptDir>
    <SptSharedAssembliesDir Condition=" '$(SptSharedAssembliesDir)' != '' ">$([MSBuild]::EnsureTrailingSlash('$(SptSharedAssembliesDir)'))</SptSharedAssembliesDir>
    <!-- Global command-line properties cannot be reassigned. Normalize into
         derived properties as well, so callers need not supply a trailing slash. -->
    <TscSptRoot Condition=" '$(SptDir)' != '' ">$([MSBuild]::EnsureTrailingSlash('$(SptDir)'))</TscSptRoot>
    <TscSharedAssembliesRoot Condition=" '$(SptSharedAssembliesDir)' != '' ">$([MSBuild]::EnsureTrailingSlash('$(SptSharedAssembliesDir)'))</TscSharedAssembliesRoot>
    <SptVersion Condition=" '$(SptVersion)' == '' ">410x</SptVersion>
    <SptBepInExPluginsDir Condition=" '$(SptDir)' != '' ">$(TscSptRoot)BepInEx\plugins\</SptBepInExPluginsDir>
    <SptBepInExPatchersDir Condition=" '$(SptDir)' != '' ">$(TscSptRoot)BepInEx\patchers\</SptBepInExPatchersDir>
    <SptServerRuntimeDir Condition=" '$(SptDir)' != '' ">$(TscSptRoot)SPT_Runtime\</SptServerRuntimeDir>
    <SptServerModsDir Condition=" '$(SptServerRuntimeDir)' != '' ">$(SptServerRuntimeDir)user\mods\</SptServerModsDir>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <OutputPath>Build\Debug\</OutputPath>
    <Optimize>false</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <NoWarn>1701;1702;0649</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'SPT-3.10 Release|AnyCPU' ">
    <OutputPath>Build\SPT-3.10\</OutputPath>
    <SptVersion>310x</SptVersion>
    <Optimize>true</Optimize>
    <NoWarn>1701;1702;0649</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'SPT-3.11 Release|AnyCPU' ">
    <OutputPath>Build\SPT-3.11\</OutputPath>
    <SptVersion>311x</SptVersion>
    <Optimize>true</Optimize>
    <NoWarn>1701;1702;0649</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'SPT-4.0 Release|AnyCPU' ">
    <OutputPath>Build\SPT-4.0\</OutputPath>
    <SptVersion>400x</SptVersion>
    <Optimize>true</Optimize>
    <NoWarn>1701;1702;0649</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'SPT-4.1 Release|AnyCPU' ">
    <OutputPath>Build\SPT-4.1\</OutputPath>
    <SptVersion>410x</SptVersion>
    <Optimize>true</Optimize>
    <NoWarn>1701;1702;0649</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="$([System.String]::Copy('$(Configuration)').Contains('Release'))">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildThisFileDirectory)=/_/src</PathMap>
  </PropertyGroup>

  <Target Name="GenerateModMetadata" BeforeTargets="BeforeCompile" Inputs="$(MSBuildAllProjects)" Outputs="$(IntermediateOutputPath)ModMetadata.cs">
    <ItemGroup>
      <ModMetadataFilePath Include="$(IntermediateOutputPath)ModMetadata.cs" />
      <GeneratedText Include="// -- Created at build time --" />
      <GeneratedText Include="// --------- DO NOT MODIFY ----------" />
      <GeneratedText Include="%23pragma warning disable CS1591 // Missing XML comment for publicly visible type or member" />
      <GeneratedText Include="namespace $(RootNamespace)%3B" />
      <GeneratedText Include="internal static class ModMetadata" />
      <GeneratedText Include="%7B" />
      <GeneratedText Include='%09public const string VERSION = "$(Version)"%3B' />
      <GeneratedText Include='%09public const string TARGET_SPT_VERSION = "$(TargetSptVersion)"%3B' />
      <GeneratedText Include="%7D" />
    </ItemGroup>
    <ItemGroup>
      <Compile Include="@(ModMetadataFilePath)" />
    </ItemGroup>
    <WriteLinesToFile File="@(ModMetadataFilePath)" Lines="@(GeneratedText)" Overwrite="true" />
  </Target>
</Project>
