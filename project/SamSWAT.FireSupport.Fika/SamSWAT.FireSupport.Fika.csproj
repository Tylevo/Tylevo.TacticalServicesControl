<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SamSWAT.FireSupport.ArysReloaded.Fika</RootNamespace>
    <!-- Keep internal identity stable for compatibility; release packaging keeps the public TSC filename. -->
    <AssemblyName>SamSWAT.FireSupport.ArysReloaded.Fika</AssemblyName>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Authors>Tylevo, SamSWAT, Arys</Authors>
    <Copyright>Copyright (c) Tylevo, SamSWAT, Arys 2026</Copyright>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    This plugin assembly is chainloaded by BepInEx on every install, including
    single-player installs without Fika. It must never reference Fika.Core, directly
    or through types in signatures, or assembly-wide type scans by other mods throw
    ReflectionTypeLoadException. All Fika-typed code lives in the Interop project,
    which is loaded explicitly at runtime only when com.fika.core is present.
  -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(SptSharedAssembliesDir)$(SptVersion)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SptSharedAssembliesDir)$(SptVersion)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptSharedAssembliesDir)$(SptVersion)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SamSWAT.FireSupport.Fika.Interop\SamSWAT.FireSupport.Fika.Interop.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="build\**" />
    <Compile Remove="build\**" />
    <EmbeddedResource Remove="build\**" />
    <None Remove="obj\**" />
    <Compile Remove="obj\**" />
    <EmbeddedResource Remove="obj\**" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition=" '$(SkipTscDeploy)' != 'true' ">
    <Exec Command="if not exist &quot;$(SptBepInExPluginsDir)$(SolutionName)&quot; (&#xA;    mkdir &quot;$(SptBepInExPluginsDir)$(SolutionName)&quot;&#xA;)&#xA;&#xA;copy &quot;$(TargetPath)&quot; &quot;$(SptBepInExPluginsDir)$(SolutionName)\$(TargetFileName)&quot;" />
  </Target>
</Project>
